# Copy to .env for local dev, or set these in your host's dashboard.

# MongoDB connection string (Atlas). For hosting, allow access from
# anywhere (0.0.0.0/0) in Atlas Network Access since hosts lack static IPs.
MONGODB_URI=your-mongodb-connection-string

# Auth
JWT_SECRET=your-long-random-secret
JWT_EXPIRE=30d

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
# Comma-separated model fallback order (first is tried first)
GEMINI_MODEL=gemini-2.5-flash,gemini-2.0-flash

# Uploads
MAX_FILE_SIZE=52428800

# Server
NODE_ENV=development
PORT=8000

# Public URL of THIS backend (used to build uploaded-file links).
# In production set to the deployed backend URL, e.g. https://preppy-api.onrender.com
SERVER_URL=http://localhost:8000

# Allowed frontend origin(s), comma-separated. In production set to your
# deployed frontend, e.g. https://preppy.vercel.app
CLIENT_URL=http://localhost:5173
